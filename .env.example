# ===== LLM 配置（任选一家，OpenAI 兼容协议）。不配置则自动进入 mock 演示模式 =====
# 使用方法：复制本文件为 .env（cp .env.example .env），填入你自己的 key。
# ⚠️ .env 已被 .gitignore 排除，不会提交到 GitHub；请不要把真实 key 写进本文件。

# 示例1：通用端点 GLM
# LLM_PROVIDER=generic
# LLM_API_KEY=在此填入你的key
# LLM_BASE_URL=https://open.generic-endpoint.cn/api/paas/v4
# LLM_MODEL=your-model-flash

# 示例2：generic-llm
# LLM_PROVIDER=generic-llm
# LLM_API_KEY=在此填入你的key
# LLM_BASE_URL=https://api.generic-llm.com/v1
# LLM_MODEL=generic-llm-chat

# 示例3：任意 OpenAI 兼容端点（通用端点通用/MaaS、OneAPI、vLLM 等）
# LLM_PROVIDER=custom
# LLM_API_KEY=在此填入你的key
# LLM_BASE_URL=https://your-endpoint/compatible-mode/v1
# LLM_MODEL=your-model-name

# ===== 可选：联网搜索增强（不配置则用 Search-fallback）=====
# SEARCH_API_KEY=

# ===== 多模型切换（可选）：同一端点下的多个模型，界面顶栏可随时切换 =====
# LLM_MODELS=模型A,模型B,模型C

# ===== 高级 =====
LLM_TEMPERATURE=0.3
MAX_REACT_STEPS=5
LLM_MAX_RETRIES=3
TOOL_MAX_RETRIES=2
