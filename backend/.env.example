# ============================================================================
# 拓径 PATHFORGE — 环境变量模板
# 使用方法：cp .env.example .env 然后填入你自己的值（.env 已被 .gitignore 排除）
# 全部变量均为占位符，不含任何真实凭据；本文件可安全提交。
# ============================================================================

# ---------------- 应用 ----------------
APP_NAME=PATHFORGE
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# 前端开发服务器地址（Vite），多个用逗号分隔
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------------- LLM 配置（OpenAI 兼容协议，任何兼容端点均可） ----------------
# 不填 / 填不全时，后端自动进入离线 mock 模式，无需任何外部依赖即可跑通全流程
LLM_PROVIDER=openai-compatible
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_MODEL=your-model-name
# 可切换模型列表（界面顶部下拉），逗号分隔
LLM_MODELS=your-model-name,your-backup-model
# 主模型连续失败时自动降级到的备用模型（可留空）
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.3
# 单个子任务内 ReAct 最大循环次数
MAX_REACT_STEPS=5
LLM_MAX_RETRIES=3
TOOL_MAX_RETRIES=2
# 计划最多子任务数
MAX_TASKS=6
# 单次运行超时（秒）
TASK_TIMEOUT=300
# 隐私模式：true 时会话不落盘
PRIVACY_MODE=false

# ---------------- 数据库 ----------------
# 生产：PostgreSQL（需 pip install -r requirements-postgres.txt）
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pathforge
# DATABASE_URL 留空时自动使用 SQLite，开箱即跑
SQLITE_FALLBACK_URL=sqlite:///./data/pathforge.db

# ---------------- Redis（短期记忆 / 任务队列） ----------------
# 留空或连接失败时自动降级为进程内实现，不影响启动
REDIS_URL=redis://localhost:6379/0

# ---------------- 向量库（长期记忆） ----------------
# 留空时降级为本地文件向量存储
VECTOR_STORE_URL=http://localhost:8000
VECTOR_STORE_PATH=./data/vectors
EMBEDDING_MODEL=your-embedding-model

# ---------------- 沙箱（工具执行隔离） ----------------
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=300
SANDBOX_MAX_OUTPUT=65536
# 工作区根目录：Agent 的文件读写被严格限定在此范围内
WORKSPACE_ROOT=./workspaces
# 是否允许「完全访问」权限模式（生产环境建议 false）
ALLOW_FULL_ACCESS=false

# ---------------- 联网检索增强（可选） ----------------
# 留空时使用免密钥的公开检索通道
SEARCH_API_KEY=

# ---------------- 数据加密 ----------------
# 留空时自动生成 data/.key（该文件不入库）
DATA_KEY=
