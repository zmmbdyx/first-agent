{
  "_schema": {
    "用途": "P1-4 黄金集质量回归：20 条确定性用例，覆盖「文本JD文件 / 粘贴JD / 信息不足追问 / 异常输入 / 敏感拦截 / 闲聊情绪」六类形态。由 tests/golden_eval.py 执行与评分。",
    "字段": {
      "id": "用例编号（g01..g20），--only 参数按此过滤",
      "category": "file_jd / paste_jd / ask_user / abnormal / blocked / chitchat —— 用于覆盖矩阵与追问正确率统计",
      "difficulty": "易 / 中 / 难",
      "task": "发给 Agent 的用户消息（可用 {JD_PASTE} / {JD_NOISY} / {JD_LONG} 占位符，由 golden_eval.py 展开成长文本）",
      "followup": "可选：同一会话的第二轮消息（多轮追问-恢复用例）",
      "why": "这条用例防的是什么回归（一句话）",
      "expect": {
        "must_contain": "必须出现在「最终回复」里的短词（只写确定会出现的词，避免假失败）",
        "must_not_contain": "违规词：出现在最终回复 / 任何 assistant 消息 / 子任务结果中即判违规",
        "min_tasks_done": "至少完成的子任务数（status=done）",
        "tool_calls_min": "工具调用次数下限（验证确实用了工具）",
        "tool_calls_max": "工具调用次数上限（默认 12，步骤效率）",
        "max_tasks": "子任务总数上限（默认 6，步骤效率）",
        "score_range": "[lo, hi]：artifacts.match.score 的允许区间；无匹配分即判失败",
        "expect_status": "期望会话终态：done（跑完）/ awaiting_input（等待补充材料）",
        "expect_ask_user": "必须产生 ask_user 事件（信息不足类）",
        "expect_event": "必须出现的事件类型（如 security_block）",
        "expect_no_plan": "必须不生成计划（拦截/闲聊类直接响应，不跑流水线）",
        "expect_report": "必须落盘报告文件（artifacts.report.path 非空）",
        "forbid_tool_calls": "必须零工具调用（闲聊 / 情绪 / 拦截 / 追问前）",
        "forbid_tools": "禁止出现的工具名（如粘贴JD场景不得出现 file_read）"
      }
    },
    "口径": "mock 模式下所有断言都是确定性的（分数来自 jd_analyze/resume_match 的真实计算）；--real 模式下模型规划形态可能不同，阈值需人工判读。"
  },
